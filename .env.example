# Gnani.ai Speech Services API Key (covers both STT and TTS)
# Obtain your key at: https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key_here

# LLM API Keys (optional if using hosted LLM providers)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Speech Model Settings
GNANI_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5
GNANI_STT_LANG=en-IN
GNANI_TTS_LANG=en-IN
